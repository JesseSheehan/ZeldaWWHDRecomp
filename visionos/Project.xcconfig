// Settings shared by the visionOS projects (base configuration of each project).
//
// WWHD_RUNTIME_BUILD: the visionOS libraries from tools/visionos/build.sh (default build directory).
WWHD_RUNTIME_BUILD = $(SRCROOT)/../../build-visionos/runtime

// Your Apple development team (and any override of the above) stays out of the repository: copy
// Local.xcconfig.example to Local.xcconfig (ignored by git) and set your team ID there.
#include? "Local.xcconfig"
